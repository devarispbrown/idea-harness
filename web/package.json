{
  "name": "idea-harness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "//": "pnpm 10 blocks dependency install scripts by default (the 'Ignored build scripts' warning). Declaring the empty allowlist makes that explicit, so re-enabling install-time code execution is a reviewable diff rather than a local `pnpm approve-builds`.",
    "onlyBuiltDependencies": []
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@scalar/api-reference": "^1.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
