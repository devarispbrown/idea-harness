# Build artifacts
/bin/
/dist/
*.exe

# Local Go caches (workspace-local to avoid sandboxed home dir writes)
/.buildcache/
/.modcache/
/.gopath/

# Go
*.test
*.out
coverage.*

# Node / web
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# The embedded UI build output (internal/web/dist) is committed so `go install`
# and a clean `go build` embed the real UI with no Node toolchain. `make
# check-embed` (run in CI) rebuilds and diffs it so it cannot go stale.
.pnpm-store/

# idea-harness runtime state (must not be committed)
/.idea-harness/state/
/idea.db
/.smoke/
/.smoke-*/

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp

# go install output (local)
/.gobin/

# Design handoff (reference prototypes, not product code)
/design_handoff_idea_harness_ui/

# Claude worktrees
/.claude/
dist-api-docs/

# Stray binary if someone runs `go build ./internal/docsgen` from the repo root.
/docsgen
