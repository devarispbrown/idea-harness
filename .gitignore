# Build artifacts
/bin/
/dist/
*.exe

# Local Go caches (workspace-local to avoid sandboxed home dir writes)
/.buildcache/
/.modcache/
/.gopath/

# Go
*.test
*.out
coverage.*

# Node / web
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# The embedded UI build output. Ignored, except index.html: //go:embed needs the
# directory to exist at compile time, so a placeholder copy of
# internal/web/placeholder.html is committed there (see internal/web/web.go).
# `make embed-web` overwrites it with the real build; `make restore-embed` puts
# the placeholder back so a real build is never committed by accident.
internal/web/dist/*
!internal/web/dist/index.html
.pnpm-store/

# idea-harness runtime state (must not be committed)
/.idea-harness/state/
/idea.db
/.smoke/
/.smoke-*/

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp

# go install output (local)
/.gobin/

# Design handoff (reference prototypes, not product code)
/design_handoff_idea_harness_ui/

# Claude worktrees
/.claude/
dist-api-docs/
